# ─────────────────────────────────────────────────────────────────
#  LOCAL environment variables
#  Copy to .env and fill in your values
#  DB: myiu_local (only affects your workstation, safe to reset)
# ─────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── Database ──────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/myiu_local
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── JWT ───────────────────────────────────────────────────────────
# Local default is safe for workstation only — never use in any server environment
# Generate a real secret: openssl rand -hex 64
JWT_SECRET=local-dev-secret-key-min-256-bits-ONLY-for-localhost-never-production-use
JWT_EXPIRATION_MS=86400000

# ── Microsoft OAuth2 ──────────────────────────────────────────────
# Get from your Azure App Registration (portal.azure.com)
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# ── URLs ──────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces between entries)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Storage ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Email (SMTP) ──────────────────────────────────────────────────
# Optional for local dev — leave blank to skip email sending
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Provisioning Limits ───────────────────────────────────────────
PROVISION_MAX_CREATE=200
PROVISION_MAX_DELETE=100
