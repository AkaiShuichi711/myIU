# ─────────────────────────────────────────────────────────────────
#  LOCAL environment variables
#  Copy to .env and fill in your values
#  DB: myiu_local (only affects your workstation)
# ─────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# Database — local only, safe to reset
DB_URL=jdbc:postgresql://localhost:5432/myiu_local
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Azure AD (get from your Azure App Registration)
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# File storage
UPLOAD_DIR=./uploads
APP_BASE_URL=http://localhost:8080

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Mail (optional for local)
SMTP_USER=
SMTP_PASS=

# Provisioning limits
PROVISION_MAX_CREATE=200
PROVISION_MAX_DELETE=100
