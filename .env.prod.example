# ─────────────────────────────────────────────────────────────────
#  PROD environment variables
#  DB: myiu_prod  (production database — handle with care)
#  All secrets MUST come from environment variables — no fallbacks
#  Used by: docker-compose.prod.yml
#
#  SECURITY: Never commit actual .env.prod to git.
#  In CI/CD: store as GitHub Secrets, write to file on deploy.
# ─────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
REGISTRY=ghcr.io/your-org
TAG=v1.0.0

# ── Database ──────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://postgres:5432/myiu_prod
DB_USERNAME=myiu_prod_user
DB_PASSWORD=CHANGE_ME_very_strong_password

# ── JWT ───────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64  — must be different from dev secret
JWT_SECRET=CHANGE_ME_prod_secret_min_64_hex_chars_different_from_dev
JWT_EXPIRATION_MS=86400000

# ── Microsoft OAuth2 ──────────────────────────────────────────────
# Production app registration in Azure portal
AZURE_CLIENT_ID=prod-azure-client-id
AZURE_CLIENT_SECRET=prod-azure-client-secret
AZURE_TENANT_ID=your-tenant-id

# ── URLs ──────────────────────────────────────────────────────────
APP_BASE_URL=https://api.myiu.edu.vn
FRONTEND_URL=https://myiu.edu.vn

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated; falls back to FRONTEND_URL if not set
CORS_ALLOWED_ORIGINS=https://myiu.edu.vn

# ── File Storage ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Email (SMTP) ──────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@myiu.edu.vn
MAIL_PASSWORD=CHANGE_ME_smtp_password


# ── Server ────────────────────────────────────────────────────────
SERVER_PORT=8080
