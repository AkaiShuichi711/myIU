# ─────────────────────────────────────────────────────────────────
#  PROD environment variables
#  DB: myiu_prod
#  Used by: docker-compose.prod.yml
#
#  SECURITY: Never commit actual .env.prod to git.
#  In CI/CD: store as GitHub Secrets, write to file on deploy.
# ─────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
REGISTRY=ghcr.io/your-org
TAG=v1.0.0

# DB on prod server (dedicated server or managed DB service)
DB_URL=jdbc:postgresql://postgres:5432/myiu_prod
DB_USERNAME=myiu_prod_user
DB_PASSWORD=CHANGE_ME_very_strong_password

# Secrets — generate: openssl rand -hex 64
PORTAL_JWT_SECRET=CHANGE_ME_prod_portal_secret_min_64_hex
ADMIN_JWT_SECRET=CHANGE_ME_prod_admin_secret_different

# Azure AD — production app registration
AZURE_CLIENT_ID=prod-azure-client-id
AZURE_CLIENT_SECRET=prod-azure-client-secret
AZURE_TENANT_ID=your-tenant-id

# URLs
PORTAL_FRONTEND_URL=https://myiu.edu.vn
ADMIN_FRONTEND_URL=https://admin.myiu.edu.vn
PORTAL_API_URL=https://api.myiu.edu.vn
ADMIN_API_URL=https://admin-api.myiu.edu.vn
