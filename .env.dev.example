# ─────────────────────────────────────────────────────────────────
#  DEV server environment variables
#  DB: myiu_dev  (shared team database on dev server)
#  All secrets MUST come from environment variables — no fallbacks
#  Used by: docker-compose.dev.yml
# ─────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
REGISTRY=ghcr.io/your-org

# ── Database ──────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://postgres:5432/myiu_dev
DB_USERNAME=myiu_dev_user
DB_PASSWORD=CHANGE_ME_strong_password

# ── JWT ───────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_at_least_64_hex_chars
JWT_EXPIRATION_MS=86400000

# ── Microsoft OAuth2 ──────────────────────────────────────────────
# Can reuse the same app registration as local, or create a separate dev app
AZURE_CLIENT_ID=dev-azure-client-id
AZURE_CLIENT_SECRET=dev-azure-client-secret
AZURE_TENANT_ID=your-tenant-id

# ── URLs ──────────────────────────────────────────────────────────
APP_BASE_URL=https://dev-api.myiu.edu.vn
FRONTEND_URL=https://dev.myiu.edu.vn

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated; falls back to FRONTEND_URL if not set
CORS_ALLOWED_ORIGINS=https://dev.myiu.edu.vn

# ── File Storage ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Email (SMTP) ──────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password


# ── Server ────────────────────────────────────────────────────────
SERVER_PORT=8080
