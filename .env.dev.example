# ─────────────────────────────────────────────────────────────────
#  DEV server environment variables
#  DB: myiu_dev
#  Used by: docker-compose.dev.yml
# ─────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
REGISTRY=ghcr.io/your-org

# DB on dev server
DB_URL=jdbc:postgresql://postgres:5432/myiu_dev
DB_USERNAME=myiu_dev_user
DB_PASSWORD=CHANGE_ME_strong_password

# Secrets — generate with: openssl rand -hex 64
PORTAL_JWT_SECRET=CHANGE_ME_at_least_64_hex_chars
ADMIN_JWT_SECRET=CHANGE_ME_different_from_portal

# Azure AD — same app as local OR separate dev app
AZURE_CLIENT_ID=dev-azure-client-id
AZURE_CLIENT_SECRET=dev-azure-client-secret
AZURE_TENANT_ID=your-tenant-id

# URLs
PORTAL_FRONTEND_URL=https://dev.myiu.edu.vn
ADMIN_FRONTEND_URL=https://dev-admin.myiu.edu.vn
PORTAL_API_URL=https://dev-api.myiu.edu.vn
ADMIN_API_URL=https://dev-admin-api.myiu.edu.vn
