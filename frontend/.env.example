# Appwrite Configuration (copy to .env.local and replace placeholders)
# Where to get these values:
# - APPWRITE_URL: your Appwrite endpoint (e.g. http://localhost/v1)
# - PROJECT_ID: create a Project in Appwrite Console and copy the Project ID
# - DATABASE/BUCKET/COLLECTION IDs: create Database, Collections and Storage
#   in Appwrite Console (see appwrite/README.md or run appwrite/scripts/create-appwrite-schema.ts)
# IMPORTANT: Do NOT add your Appwrite Admin API key here. The Admin key is only
# required by the schema-creation script and must be kept secret (store in
# appwrite/scripts/.env, not in frontend env files).
VITE_APPWRITE_URL=http://localhost/v1
VITE_APPWRITE_PROJECT_ID=YOUR_PROJECT_ID
VITE_APPWRITE_DATABASE_ID=YOUR_DATABASE_ID
VITE_APPWRITE_STORAGE_ID=YOUR_STORAGE_ID
VITE_APPWRITE_SAVES_COLLECTION_ID=YOUR_SAVES_COLLECTION_ID
VITE_APPWRITE_USERS_COLLECTION_ID=YOUR_USERS_COLLECTION_ID
VITE_APPWRITE_POSTS_COLLECTION_ID=YOUR_POSTS_COLLECTION_ID

# Phase 2 collections (tạo thủ công trong Appwrite Console - xem README Phần 6)
VITE_APPWRITE_NOTIFICATIONS_COLLECTION_ID=YOUR_NOTIFICATIONS_COLLECTION_ID
VITE_APPWRITE_COMMENTS_COLLECTION_ID=YOUR_COMMENTS_COLLECTION_ID
VITE_APPWRITE_BLOCKS_COLLECTION_ID=YOUR_BLOCKS_COLLECTION_ID

# --- Admin script settings (optional) ---
# If you want the create-appwrite-schema.ts script to run using the same .env,
# you can add the Admin API key here. WARNING: this exposes a powerful key; do
# NOT commit it to git. If you prefer, keep the admin key in a separate file.
# APPWRITE_API_KEY: Admin/service API key you create in Appwrite Console
# APPWRITE_ENDPOINT: Appwrite endpoint used by the admin script (default http://localhost/v1)
APPWRITE_ENDPOINT=http://localhost/v1
# APPWRITE_API_KEY=YOUR_ADMIN_API_KEY
# APPWRITE_PROJECT_ID=YOUR_PROJECT_ID # optional; if set script will use it


# Microsoft Authentication (Azure AD) Configuration
# Where to get these values:
# - Go to Azure Portal -> Azure Active Directory -> App registrations -> Your app
# - Copy the Application (client) ID -> set to VITE_AD_CLIENT_ID
# - Copy the Directory (tenant) ID -> set to VITE_AD_TENANT_ID
# - Set VITE_REDIRECT_URI to the redirect URI registered in the App Registration
#   when using the frontend dev proxy, use http://localhost:5173/redirect
VITE_AD_CLIENT_ID=your-azure-app-client-id
VITE_AD_TENANT_ID=your-azure-tenant-id
VITE_REDIRECT_URI=http://localhost:5173/redirect

# For production, add your production domain:
# VITE_REDIRECT_URI=https://yourdomain.com/redirect

# Backend OAuth server (O365Auth) - where frontend will redirect for Office365 login
# When using the frontend dev proxy, use http://localhost:5173
# Otherwise for direct backend connection, use http://localhost:8080
VITE_OAUTH_BACKEND_URL=http://localhost:5173
