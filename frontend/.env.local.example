# Template for local developer overrides.
# Copy to .env.local and fill in your real values. Never commit .env.local.
#
# Vite env loading priority (highest to lowest):
#   .env.{mode}.local > .env.{mode} > .env.local > .env
# Files ending in .local are gitignored by *.local in .gitignore.

# ── Backend ──────────────────────────────────────────────────────────────────
# Spring Boot API base URL (used for all REST calls and Vite dev proxy target)
VITE_API_URL=http://localhost:8080

# WebSocket/SockJS base URL — usually the same as VITE_API_URL.
# Note: SockJS uses HTTP transport (http://), not native ws:// protocol.
# The /ws suffix is appended automatically in useNotificationSocket.ts.
VITE_WS_URL=http://localhost:8080

# ── App meta ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=myIU Portal
VITE_APP_ENV=local
# Frontend origin — used for MS SSO post-logout redirect URI
VITE_APP_URL=http://localhost:5173

# ── Microsoft Azure AD ───────────────────────────────────────────────────────
# Azure Portal → Azure Active Directory → App registrations → Your app
# Application (client) ID
VITE_AD_CLIENT_ID=your-azure-client-id
# Directory (tenant) ID
VITE_AD_TENANT_ID=your-azure-tenant-id
# Must match a redirect URI registered in the App Registration
VITE_REDIRECT_URI=http://localhost:5173/redirect
