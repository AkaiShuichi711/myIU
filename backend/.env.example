# ============================================================
# myIU Portal – Environment variable template
# Copy this file to .env and fill in real values
# ============================================================

# --- Azure AD / Microsoft 365 OAuth2 ---
# Get these from Azure Portal > App Registrations > your app
AZURE_CLIENT_ID=<your-azure-app-client-id>
AZURE_CLIENT_SECRET=<your-azure-app-client-secret>
AZURE_TENANT_ID=<your-azure-tenant-id>

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/myIU_dev
DB_USERNAME=postgres
DB_PASSWORD=<your-db-password>

# --- JWT ---
# Generate: openssl rand -hex 32
JWT_SECRET=<min-256-bit-random-secret>

# --- Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- File storage ---
UPLOAD_DIR=./uploads
APP_BASE_URL=http://localhost:8080

# --- User Provisioning limits per Excel run ---
PROVISION_MAX_CREATE=200
PROVISION_MAX_DELETE=100

# --- SMTP (Gmail SMTP, free) ---
# Hướng dẫn: https://myaccount.google.com/apppasswords
#   1. Bật 2-Step Verification trên Gmail
#   2. Tạo App Password → chọn "Mail" + device "Other"
#   3. Copy 16-ký-tự dán vào SMTP_PASS
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# URL frontend (dùng trong link email)
FRONTEND_URL=http://localhost:5173
