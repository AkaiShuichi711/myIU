# ============================================================
# myIU Portal – Environment variable template
# Copy this file to .env and fill in real values
# ============================================================

# --- Azure AD / Microsoft 365 OAuth2 ---
# Get these from Azure Portal > App Registrations > your app
AZURE_CLIENT_ID=<your-azure-app-client-id>
AZURE_CLIENT_SECRET=<your-azure-app-client-secret>
AZURE_TENANT_ID=<your-azure-tenant-id>

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/myIU_dev
DB_USERNAME=postgres
DB_PASSWORD=<your-db-password>

# --- JWT ---
# Generate: openssl rand -hex 32
JWT_SECRET=<min-256-bit-random-secret>

# --- Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- File storage ---
# Must resolve to the SAME physical folder as myIU-admin/backend/.env's
# UPLOAD_DIR (use an absolute path for both if they aren't already
# started from a shared working directory) — the admin backend uploads
# files here but writes download URLs pointing at THIS backend
# (/api/storage/files/...), so a mismatched folder means every file the
# admin panel uploads 404s when downloaded from the portal.
UPLOAD_DIR=./uploads
APP_BASE_URL=http://localhost:8080

